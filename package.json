{
  "name": "roomfit-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e:subpath": "playwright test --config playwright.subpath.config.ts",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "konva": "10.9.1",
    "react-konva": "19.3.2",
    "three": "0.187.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "zustand": "5.0.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "27.4.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/node": "22.20.5"
  }
}
